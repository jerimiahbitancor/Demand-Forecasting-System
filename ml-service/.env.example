# Supabase (same project your Express backend already uses)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# Shared secret so only your Express backend can call this service.
# This is NOT something you "get" from anywhere — you invent it
# yourself: any long random string works. Generate one with, e.g.:
#   openssl rand -hex 32          (Mac/Linux/WSL)
#   python -c "import secrets; print(secrets.token_hex(32))"   (any OS with Python)
# Put the SAME value here and in Express's environment variables —
# it's a shared password between your two services, not a credential
# issued by Supabase, Render, or anyone else.
# (this is NOT optional for a public Render URL — see README "Security" section)
ML_SERVICE_SHARED_SECRET=change-me-to-a-long-random-string

# Local scratch directory only — NOT durable storage. XGBoost needs a
# real file path to save/load to; the actual persistent copy lives in
# Supabase Storage (see SUPABASE_MODEL_BUCKET below). Render's disk is
# ephemeral, so nothing here survives a restart — that's expected.
MODEL_DIR=./models

# Supabase Storage bucket where trained models actually persist.
# Create this bucket once in your Supabase dashboard (Storage tab)
# before the first training run.
SUPABASE_MODEL_BUCKET=ml-models

# A per-product data-sufficiency gate, corrected per the eligibility
# clarification: this counts ACTUAL VALID DAILY SALES OBSERVATIONS
# (unique dates present in daily_sales for that product), never
# calendar days elapsed since the product was first sold. A product
# open 40 calendar days with sales on only 20 of those days has 20
# observations, not 40, and stays ineligible until it reaches this
# threshold. Renamed from the old MIN_TRAINING_DAYS, which implied
# (incorrectly) a calendar-age requirement.
MIN_TRAINING_OBSERVATIONS=28

# Prints DataFrame shape/head + evaluation metrics to the console at
# each pipeline stage (preprocessing, feature engineering, split,
# training). Leave false in normal operation; turn on when debugging.
ML_DEBUG=false

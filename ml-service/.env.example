# Supabase (same project your Express backend already uses)
SUPABASE_URL=https://bvsivqengdoslryiazyr.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImJ2c2l2cWVuZ2Rvc2xyeWlhenlyIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc4MzI2OTA1OCwiZXhwIjoyMDk4ODQ1MDU4fQ.HISppch1h0xu7RHZmDYgYv0gEAxEHt-Q8ROyRJau3VA

# Shared secret so only your Express backend can call this service
# (this is NOT optional for a public Render URL — see README "Security" section)
ML_SERVICE_SHARED_SECRET=change-me-to-a-long-random-string

# Local scratch directory only — NOT durable storage. XGBoost needs a
# real file path to save/load to; the actual persistent copy lives in
# Supabase Storage (see SUPABASE_MODEL_BUCKET below). Render's disk is
# ephemeral, so nothing here survives a restart — that's expected.
MODEL_DIR=./models

# Supabase Storage bucket where trained models actually persist.
# Create this bucket once in your Supabase dashboard (Storage tab)
# before the first training run.
SUPABASE_MODEL_BUCKET=ml-models

# Minimum days of history required before a product is included in
# the pooled training set for the global model
MIN_TRAINING_DAYS=90
